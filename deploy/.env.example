# 环境变量（复制为 .env 后按需修改；.env 不进版本库）
DB_PASS=campusslot
DB_PORT=3307
REDIS_PORT=6379
# 本机开发 1gb 够用；服务器按执行方案 §4.2 给 4gb
REDIS_MAXMEMORY=1gb
GRAFANA_PASS=admin

# Broker 的 store 目录（默认 ./data/store，落在仓库所在盘）。
# 如果那个盘的使用率高于 85%，Broker 会开始强制清理过期文件；高于 90% 会直接拒写，
# 报错是 response-code=50001 "the broker's disk is full [CL: 0.91 ...]"。
# 阈值不要往上抬（那只是消音），把 store 挪到一个空盘：
# RMQ_STORE_DIR=C:/campusslot-rmq-store
# 换目录后 store 里没有 topics.json，要重跑 bash deploy/topic-init.sh。
RMQ_STORE_DIR=./data/store

# 应用侧（IDEA 启动时读取，或直接改 application.yml）
# MQ_ENABLED=true
# MQ_ENDPOINTS=127.0.0.1:8081
# 演示「超时释放」时把它调到 60，不用等 30 分钟（R-5 默认 1800 秒）
# CONFIRM_TIMEOUT_SEC=60
# SYS-3 对账巡检间隔，默认 5 分钟
# RECONCILE_INTERVAL_MS=300000
